# ===================================
# PORTFOLIO WEBSITE - ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your values
# cp .env.example .env (Linux/Mac)
# copy .env.example .env (Windows)

# ===================================
# REQUIRED SETTINGS
# ===================================

# Secret key for Flask sessions (generate a random string)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here_change_in_production

# Google Gemini API Key (Required for AI Chat)
# Get one at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# DATABASE CONFIGURATION
# ===================================

# Database type: 'sqlite' for development, 'mysql' for production
DB_TYPE=sqlite

# MySQL Configuration (only needed if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=portfolio
MYSQL_PORT=3306

# ===================================
# OPTIONAL SETTINGS
# ===================================

# Port for local development (default: 5000)
PORT=5000

# Debug mode (set to False in production)
DEBUG=False

# Allowed origins for CORS (comma-separated)
# Use '*' to allow all origins (development only)
# For production, specify your domain: https://yourdomain.com
ALLOWED_ORIGINS=*
